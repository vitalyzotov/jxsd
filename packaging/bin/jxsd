#!/bin/sh
# Launcher for the jxsd CLI. Resolves the bundled jar relative to this script,
# honoring JXSD_OPTS for extra JVM options (e.g. -Xmx512m).

PRG="$0"
while [ -h "$PRG" ]; do
    ls=$(ls -ld "$PRG")
    link=$(expr "$ls" : '.*-> \(.*\)$')
    case "$link" in
        /*) PRG="$link" ;;
        *) PRG=$(dirname "$PRG")/"$link" ;;
    esac
done

DIR=$(cd "$(dirname "$PRG")" && pwd)
JAR="$DIR/../lib/jxsd.jar"

if [ ! -f "$JAR" ]; then
    echo "jxsd: cannot find $JAR" >&2
    exit 1
fi

exec java ${JXSD_OPTS:-} -jar "$JAR" "$@"
