<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic fixture with an unresolvable include: the loader logs the missing
     dependency but still exposes the components it could parse. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:md="http://example.org/missing/v1/"
           targetNamespace="http://example.org/missing/v1/"
           elementFormDefault="qualified">

  <xs:include schemaLocation="does-not-exist.core.v1.xsd"/>

  <xs:element name="Standalone" type="xs:string"/>
</xs:schema>
